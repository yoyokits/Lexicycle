<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="LexicycleApp.Views.SummaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LexicycleApp.ViewModels"
    x:DataType="vm:SummaryViewModel"
    Title="Summary">

    <!--
        The CollectionView sits directly in the star row. Nesting it inside a
        VerticalStackLayout makes it measure against infinite height, which collapses
        every other row in the Grid to zero.
    -->
    <Grid Padding="20,16" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!--
            The milestone banner. Starts invisible and is animated in by the code-behind,
            so the opacity and scale here are the pre-animation state, not the final look.
        -->
        <Border
            x:Name="MilestoneBanner"
            Grid.Row="0"
            Margin="0,0,0,18"
            Padding="18,16"
            BackgroundColor="{StaticResource Primary}"
            IsVisible="{Binding HasMilestone}"
            Opacity="0"
            Scale="0.8"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Label
                    x:Name="MilestoneBadge"
                    Grid.Column="0"
                    FontSize="40"
                    Text="🏆"
                    VerticalOptions="Center" />

                <VerticalStackLayout
                    x:Name="MilestoneText"
                    Grid.Column="1"
                    Opacity="0"
                    Spacing="3"
                    TranslationY="8"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="{Binding MilestoneTitle}"
                        TextColor="White" />
                    <Label
                        FontSize="13"
                        Text="{Binding MilestoneMessage}"
                        TextColor="White"
                        Opacity="0.85" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Label
                FontAttributes="Bold"
                FontSize="32"
                Text="{Binding Headline}" />
            <Label Style="{StaticResource SubtleLabel}" Text="{Binding Detail}" />
        </VerticalStackLayout>

        <Label
            Grid.Row="2"
            Margin="0,24,0,10"
            FontAttributes="Bold"
            IsVisible="{Binding HasMissedWords}"
            Text="Worth another look" />

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding MissedWords}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SubtleLabel}"
                    Text="Nothing missed — every word was right first time."
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:MissedWordRow">
                    <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto">
                            <!--
                                Only the prompt is bold. "Answer" is now every accepted
                                translation, so a whole comma-separated list in bold
                                reads as a wall rather than as a list.
                            -->
                            <Label
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                FontSize="17"
                                VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Source}" FontAttributes="Bold" />
                                        <Span Text=" → " />
                                        <Span Text="{Binding Answer}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label
                                Grid.Column="1"
                                Style="{StaticResource SubtleLabel}"
                                Text="{Binding MissText}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="4"
            Margin="0,12,0,0"
            Command="{Binding DoneCommand}"
            Text="Back to sets" />
    </Grid>
</ContentPage>
