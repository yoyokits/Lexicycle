<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="LexicycleApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dictionary="clr-namespace:LexicycleCore.Dictionary;assembly=LexicycleCore"
    xmlns:vm="clr-namespace:LexicycleApp.ViewModels"
    x:DataType="vm:HomeViewModel"
    Title="Lexicycle">

    <Grid Padding="20,16" RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Label
                Style="{StaticResource SubtleLabel}"
                Text="Missed words come back each round until you get them right." />

            <!--
                The language switcher. Hidden entirely when only one pair's dictionary is
                bundled, which is the common case until a second pair is generated and
                shipped — see docs/DATA-SOURCES.md.
            -->
            <CollectionView
                IsVisible="{Binding HasLanguageChoice}"
                ItemsLayout="HorizontalList"
                ItemsSource="{Binding AvailablePairs}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dictionary:LanguagePair">
                        <Border
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SelectPairCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Label FontAttributes="Bold" FontSize="13" Text="{Binding Name}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--
                Direction toggle (R-305). A standalone control rather than folded into the
                Practice/band cards' own direction badges — nesting a second tap target
                inside an already-tappable Border risks both gestures firing on some
                platforms, and "which way round" is a page-level setting anyway, not a
                per-card action.
            -->
            <Border
                HorizontalOptions="Start"
                Padding="12,6"
                Stroke="{StaticResource Primary}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleDirectionCommand}" />
                </Border.GestureRecognizers>

                <Label FontAttributes="Bold" FontSize="13" Text="{Binding DirectionLabel, StringFormat='⇄ {0}'}" />
            </Border>

            <!--  The dictionary-backed session: different words every time.  -->
            <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding StartPracticeCommand}" />
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Practice" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource SubtleLabel}"
                        Text="{Binding PracticeSubtitle}" />

                    <Label
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="{Binding DirectionLabel}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label
                Margin="0,8,0,0"
                Style="{StaticResource SubtleLabel}"
                Text="Or work through a band of the dictionary:" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Bands}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SubtleLabel}"
                    Text="No vocabulary available." />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:HomeViewModel+BandRow">
                    <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=StartBandCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding Name}" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource SubtleLabel}"
                                Text="{Binding Subtitle}" />

                            <Label
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=DirectionLabel}"
                                TextColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center" />

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Label
                IsVisible="{Binding HasError}"
                Style="{StaticResource SubtleLabel}"
                Text="{Binding ErrorMessage}"
                TextColor="{StaticResource Danger}" />

            <!--
                Milestone bar. The fill width is set from code-behind against the measured
                track width: a ColumnDefinition cannot carry a binding, because column and
                row definitions do not inherit the page's BindingContext.
            -->
            <Border
                IsVisible="{Binding HasMilestone}"
                Margin="0,4,0,0"
                Style="{StaticResource Card}">

                <VerticalStackLayout Spacing="9">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="{Binding MilestoneHeadline}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Style="{StaticResource SubtleLabel}"
                            Text="{Binding MilestoneCaption}"
                            VerticalOptions="Center" />
                    </Grid>

                    <Border
                        x:Name="MilestoneTrack"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200},
                                                          Dark={StaticResource Gray600}}"
                        HeightRequest="10"
                        HorizontalOptions="Fill"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5" />
                        </Border.StrokeShape>

                        <Border
                            x:Name="MilestoneFill"
                            BackgroundColor="{StaticResource Primary}"
                            HorizontalOptions="Start"
                            StrokeThickness="0"
                            WidthRequest="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>
                        </Border>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label FontSize="15" Text="Ignore accents" />
                    <Label
                        Style="{StaticResource SubtleLabel}"
                        Text="Accept &quot;Madchen&quot; or &quot;Maedchen&quot; for &quot;Mädchen&quot;." />
                </VerticalStackLayout>

                <Switch
                    Grid.Column="1"
                    IsToggled="{Binding LenientDiacritics}"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
