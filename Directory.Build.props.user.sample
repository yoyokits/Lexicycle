<Project>

  <!--
    Copy to "Directory.Build.props.user" (gitignored) and adjust for your machine.
    Only needed when `dotnet build` cannot locate the JDK or Android SDK by itself.

    The values below are the defaults for a Visual Studio 2022/2026 install on Windows.
  -->
  <PropertyGroup>
    <JavaSdkDirectory>C:\Program Files\Android\openjdk\jdk-21.0.8</JavaSdkDirectory>
    <AndroidSdkDirectory>C:\Program Files (x86)\Android\android-sdk</AndroidSdkDirectory>
  </PropertyGroup>

</Project>
